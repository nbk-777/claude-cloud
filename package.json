{
  "name": "ufh-twin-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive prototype of one apartment's hydronic underfloor heating system (Georgian UI)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node e2e/smoke.mjs",
    "smoke:3d": "node e2e/balcony3d.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "3.2.4"
  }
}
